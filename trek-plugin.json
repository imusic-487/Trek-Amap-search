{
  "id": "amap-search",
  "name": "找地方",
  "description": "在 TREK 里直接搜遍高德地图——餐厅、景点、宝藏小店都能找，一键复制详情或添加进当前行程，坐标/地图链接/电话自动带上。Search Amap POIs inside TREK & add them to your trip in one click.",
  "icon": "Search",
  "author": "imusic-487",
  "version": "1.4.0",
  "apiVersion": 1,
  "trek": ">=3.4.0 <5.0.0",
  "type": "trip-page",
  "permissions": [
    "db:read:trips",
    "db:write:places",
    "http:outbound:restapi.amap.com"
  ],
  "egress": [
    "restapi.amap.com"
  ],
  "settings": [
    {
      "key": "amap_key",
      "scope": "user",
      "label": "高德 Web 服务 Key",
      "placeholder": "申请自 console.amap.com（Web服务类型）",
      "required": true,
      "secret": true
    },
    {
      "key": "coord_scan_concurrency",
      "scope": "user",
      "label": "修复坐标：每批并发请求数",
      "input_type": "select",
      "options": [
        { "value": "1", "label": "1（串行，最稳）" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3（默认）" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5（最快，需高德 Key 配额充裕）" }
      ],
      "hint": "数值越大扫描越快，但会同时发更多请求给高德——如果 Key 触发限流就调低",
      "required": false
    },
    {
      "key": "coord_scan_proximity",
      "scope": "user",
      "label": "修复坐标：优先按原坐标周边搜索",
      "input_type": "select",
      "options": [
        { "value": "on", "label": "开启（默认）——围绕地点原坐标搜索" },
        { "value": "off", "label": "关闭——只按名称搜索" }
      ],
      "hint": "防止同名地点（连锁店、跨区同名点）被匹配错——地点已有坐标时围绕原坐标就近搜索",
      "required": false
    },
    {
      "key": "coord_scan_radius",
      "scope": "user",
      "label": "修复坐标：周边搜索半径（米）",
      "input_type": "select",
      "options": [
        { "value": "1000", "label": "1000m" },
        { "value": "3000", "label": "3000m" },
        { "value": "5000", "label": "5000m（默认）" },
        { "value": "10000", "label": "10000m" },
        { "value": "20000", "label": "20000m" }
      ],
      "hint": "仅在上方开关开启时生效。半径内搜不到匹配结果的地点会跳过，不猜测坐标",
      "required": false
    }
  ]
}
